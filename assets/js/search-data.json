---
layout: null
permalink: /assets/js/search-data.json
---

[
  {%- assign pages = site.pages | where_exp: "p", "p.search != false" -%}
  {%- assign docs  = pages | concat: site.posts -%}
  {%- for d in docs -%}
  {
    "title": {{ d.title | default: d.name | jsonify }},
    "url": {{ d.url | relative_url | jsonify }},
    "content": {{ d.content | strip_html | jsonify }},
    "tags": {{ d.tags | default: empty | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
]
